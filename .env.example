# Environment Variables - Global Minds Academy
# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/global_minds_academy?schema=public"

# Authentication
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_EXPIRY="7d"
BCRYPT_ROUNDS="12"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Global Minds Academy"

# Email (configure when ready)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# Payment (configure when ready - Razorpay recommended for India)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# AI Tutoring (optional)
# OPENAI_API_KEY=""
# AI_PROVIDER="openai"

# File Storage (configure when ready)
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
